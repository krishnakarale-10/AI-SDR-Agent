  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "server": "node src/server.js",
    "server:dev": "node --watch src/server.js",
    "worker": "node src/worker.js",
